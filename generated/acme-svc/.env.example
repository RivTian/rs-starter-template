# cp .env.example .env  —  `just dev` loads it automatically (just's dotenv-load).
# Any config key can be overridden as ACME_SVC__<SECTION>__<KEY>.
ACME_SVC__HTTP__BIND=127.0.0.1:8080
ACME_SVC__TELEMETRY__LOG_FORMAT=pretty
# Log filter: ACME_SVC_LOG > RUST_LOG > [telemetry].log_filter
ACME_SVC_LOG=info,acme_svc=debug
