# cp .env.example .env  —  `just dev` loads it automatically (just's dotenv-load).
# Any config key can be overridden as {{env_prefix}}__<SECTION>__<KEY>.
{{env_prefix}}__HTTP__BIND=127.0.0.1:8080
{{env_prefix}}__TELEMETRY__LOG_FORMAT=pretty
# Log filter: {{env_prefix}}_LOG > RUST_LOG > [telemetry].log_filter
{{env_prefix}}_LOG=info,{{crate_name}}=debug
